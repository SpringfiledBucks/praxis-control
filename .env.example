NODE_ENV=development
APP_HOST=127.0.0.1
APP_PORT=4310
DATABASE_MODE=pglite
# PRAXIS_DATA_DIR=D:\PraxisControl
# PGLITE_DATA_DIR=D:\PraxisControl\pglite

# 全量版才启用：
# DATABASE_MODE=postgres
# DATABASE_URL=postgresql://praxis_control:change-me@127.0.0.1:5432/praxis_control
# 容器部署优先使用 DATABASE_PASSWORD_FILE，避免密码出现在环境变量或 docker inspect 中：
# DATABASE_HOST=database
# DATABASE_PORT=5432
# DATABASE_NAME=praxis_control
# DATABASE_USER=praxis_control
# DATABASE_PASSWORD_FILE=/run/secrets/praxis_db_password
DATABASE_SSL=false
# 全量版经 Tailscale Serve 访问时启用身份头白名单：
# ACCESS_MODE=tailscale
# TAILSCALE_ALLOWED_USER=you@example.com
RUN_MIGRATIONS=true
RULESET_VERSION=2026.07.28-mvp1
