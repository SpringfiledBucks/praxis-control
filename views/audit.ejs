<%- include('partials/head', { title }) %>
<section class="page-heading"><div><p class="eyebrow">追加式记录</p><h1>审计时间线</h1><p>事件不能通过普通界面删除；哈希链用于发现直接篡改，不能代替权限和备份。</p></div></section>
<section class="integrity-banner <%= verification.valid ? 'verified' : 'failed' %>" aria-live="polite"><div><span class="status <%= verification.valid ? 'ready' : 'blocked' %>"><%= verification.valid ? 'VERIFIED' : 'FAILED' %></span><strong><%= verification.valid ? '审计链完整' : '审计链异常' %></strong></div><p><%= verification.totalEvents %> 个事件 · <%= verification.aggregateCount %> 个对象<% if (!verification.valid) { %> · <%= verification.failures.length %> 处不一致<% } %></p></section>
<section class="audit-list"><% events.forEach((event) => { %><details class="audit-event"><summary><time><%= formatDate(event.created_at) %></time><strong><%= event.event_type %></strong><span><%= event.aggregate_type %></span></summary><div><p>对象：<code><%= event.aggregate_id %></code></p><p>规则：<code><%= event.ruleset_version || '无' %></code></p><p>事件哈希：<code><%= event.event_hash %></code></p><pre><%= json(event.payload) %></pre></div></details><% }) %><% if (!events.length) { %><div class="empty panel">暂无审计事件。</div><% } %></section>
<%- include('partials/foot') %>
