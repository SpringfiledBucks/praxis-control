<%- include('partials/head', { title: 'AI 顾问' }) %>

<section class="page-heading">
  <div>
    <p class="eyebrow">LLM Advisory</p>
    <h1>模型提建议，你来下判断。</h1>
    <p class="lede">顾问为每条建议提供来源、理由和不确定项。接受、修改或拒绝由你决定——不自动写入正式记录。</p>
  </div>
</section>

<div class="advisory-layout">
  <div class="advisory-main">
    <form id="advisory-form" class="form-stack">
      <section class="form-section">
        <div class="section-number">01</div>
        <div class="section-content">
          <h2>场景</h2>
          <p>选择顾问要帮你做什么——点击卡片选中，或者直接用下拉框：</p>
          <select id="useCaseSelect" name="useCase" style="margin-bottom:16px" required>
            <option value="checkin_structure">📋 日常结构化 — 从项目上下文提取候选行动、交付物和停止条件</option>
            <option value="weekly_review_draft">📊 周复盘草稿 — 根据本周记录生成进展摘要和下周建议</option>
            <option value="evidence_relations">🔗 证据关系 — 分析证据记录之间的支持、矛盾或补充关系</option>
            <option value="rule_explanation">📐 规则解释 — 解释已触发规则的输入、逻辑和输出</option>
          </select>
          <p class="current-selection" id="currentCase"><strong>当前选择：</strong>日常结构化 — 从项目上下文中提取候选行动</p>
        </div>
      </section>

      <section class="form-section">
        <div class="section-number">02</div>
        <div class="section-content">
          <h2>关联记录</h2>
          <p>顾问只能参考你显式指定的记录。需要从已有记录中复制 UUID 填入。</p>
          <label>记录 ID（逗号分隔）
            <input type="text" name="recordIds" required placeholder="复制下面的 UUID 粘贴到这里" />
            <small>从下方表格复制 <code>id</code> 列的值，多个用英文逗号隔开</small>
          </label>
          <div id="recent-records" class="top-gap">
            <p class="empty">加载已有记录中…</p>
          </div>
        </div>
      </section>

      <section class="form-section">
        <div class="section-number">03</div>
        <div class="section-content">
          <h2>补充说明（可选）</h2>
          <p>用自然语言告诉顾问你的关注点。</p>
          <label>补充指令
            <textarea name="userInstruction" maxlength="2000" rows="3" placeholder="例如：重点关注数据盘更换进度，忽略已闭环事项。帮我看看这几个证据之间有没有矛盾。"></textarea>
            <small><span id="charCount">0</span> / 2000</small>
          </label>
        </div>
      </section>

      <div class="form-actions">
        <button type="submit" class="button primary full">提交顾问请求</button>
        <small id="submit-status" class="submit-feedback"></small>
      </div>
    </form>
  </div>

  <aside class="advisory-sidebar">
    <div class="sticky-card">
      <p class="eyebrow">待处理建议</p>
      <div id="pending-list">
        <p class="loading-text">加载中…</p>
      </div>
      <small style="display:block;margin-top:12px;color:#aebbb4;line-height:1.5">建议状态: pending_user → 你决定 → 接受 / 修改后接受 / 拒绝</small>
    </div>

    <div class="panel top-gap" id="task-detail" style="display:none">
      <div class="panel-heading"><h2>建议详情</h2><button class="button small secondary" onclick="document.getElementById('task-detail').style.display='none'">✕</button></div>
      <div id="task-detail-content"></div>
    </div>
  </aside>
</div>

<script>
const form = document.getElementById('advisory-form');
const status = document.getElementById('submit-status');
const select = document.getElementById('useCaseSelect');
const currentCase = document.getElementById('currentCase');

const caseLabels = {
  checkin_structure: '日常结构化 — 从项目上下文中提取候选行动',
  weekly_review_draft: '周复盘草稿 — 根据本周记录生成进展摘要',
  evidence_relations: '证据关系 — 分析证据记录之间的关联',
  rule_explanation: '规则解释 — 解释已触发规则的逻辑',
};

select.addEventListener('change', () => {
  currentCase.innerHTML = '<strong>当前选择：</strong>' + caseLabels[select.value];
});

const textarea = document.querySelector('textarea[name="userInstruction"]');
textarea.addEventListener('input', () => { document.getElementById('charCount').textContent = textarea.value.length; });

form.addEventListener('submit', async (e) => {
  e.preventDefault();
  status.textContent = '提交中…';
  status.className = 'submit-feedback';
  try {
    const recordIds = form.recordIds.value.split(',').map(s => s.trim()).filter(Boolean);
    const res = await fetch('/api/advisory', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'x-csrf-token': '<%= csrfToken %>' },
      body: JSON.stringify({ useCase: form.useCase.value, recordIds, userInstruction: form.userInstruction.value || undefined, records: [] }),
    });
    const data = await res.json();
    if (res.ok) {
      status.innerHTML = '✓ 已提交 <code>' + data.taskId + '</code>';
      status.className = 'submit-feedback success';
      form.reset(); select.value = 'checkin_structure';
      currentCase.innerHTML = '<strong>当前选择：</strong>' + caseLabels[select.value];
      setTimeout(loadPending, 2000);
    } else {
      status.textContent = '错误: ' + data.message;
      status.className = 'submit-feedback error';
    }
  } catch (err) {
    status.textContent = '网络错误，请重试';
    status.className = 'submit-feedback error';
  }
});

const statusLabels = { queued: '排队中', running: '运行中', succeeded: '已完成', failed: '失败', pending_user: '待处理', accepted: '已接受', accepted_modified: '已修改', rejected: '已拒绝', expired: '已过期', cancelled: '已取消' };
const statusClass = (s) => ({ pending_user: 'caution', accepted: 'ready', accepted_modified: 'ready', rejected: 'blocked', failed: 'blocked', running: 'caution' })[s] || '';

async function loadPending() {
  try {
    const res = await fetch('/api/advisory/pending');
    const data = await res.json();
    const container = document.getElementById('pending-list');
    if (!data.tasks || data.tasks.length === 0) {
      container.innerHTML = '<p style="color:#aebbb4;margin:0">没有待处理的建议。</p>';
      return;
    }
    container.innerHTML = data.tasks.map(t => `
      <div class="pending-task" onclick="showTaskDetail('${t.id}')">
        <div class="pt-header">
          <span class="status ${statusClass(t.status)}">${statusLabels[t.status] || t.status}</span>
          <small>${new Date(t.created_at).toLocaleString('zh-CN', {month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'})}</small>
        </div>
        <strong>${caseLabels[t.use_case] || t.use_case}</strong>
        ${t.error_code ? '<p class="pt-error">错误: ' + t.error_code + '</p>' : ''}
      </div>
    `).join('');
  } catch (err) {
    document.getElementById('pending-list').innerHTML = '<p style="color:#aebbb4;margin:0">加载失败</p>';
  }
}

async function showTaskDetail(taskId) {
  try {
    const res = await fetch('/api/advisory/' + taskId);
    const data = await res.json();
    const t = data.task;
    const detail = document.getElementById('task-detail');
    const content = document.getElementById('task-detail-content');
    content.innerHTML = `
      <span class="status ${statusClass(t.status)}" style="margin-bottom:12px">${statusLabels[t.status] || t.status}</span>
      <h3 style="margin:12px 0 4px">${caseLabels[t.use_case] || t.use_case}</h3>
      <small style="color:var(--muted)">${new Date(t.created_at).toLocaleString('zh-CN')}</small>
      ${t.error_code ? '<p class="warning-box">错误: ' + t.error_code + '</p>' : ''}
      ${t.output && t.output.suggestions ? '<div class="detail-list" style="margin-top:16px">' + t.output.suggestions.map((s, i) => `
        <div>
          <dt>建议 ${i + 1} · ${s.targetField} · <span class="status ${s.confidence === 'high' ? 'ready' : s.confidence === 'medium' ? 'caution' : 'blocked'}">${s.confidence}</span></dt>
          <dd><strong>${s.proposedValue}</strong></dd>
          <dd style="color:var(--muted);font-size:13px;margin-top:4px">理由: ${s.rationale}</dd>
          ${s.uncertainties?.length ? '<dd style="color:var(--amber);font-size:12px;margin-top:4px">不确定: ' + s.uncertainties.join('；') + '</dd>' : ''}
        </div>
      `).join('') + '</div>' : ''}
      ${t.status === 'pending_user' ? `<div style="margin-top:20px;display:flex;gap:10px;flex-wrap:wrap"><button class="button primary small" onclick="decide('${t.id}','accepted')">接受全部</button><button class="button secondary small" onclick="decide('${t.id}','rejected')">拒绝</button></div>` : ''}
    `;
    detail.style.display = 'block';
    detail.scrollIntoView({ behavior: 'smooth' });
  } catch (err) { console.error(err); }
}

async function decide(taskId, decision) {
  const reason = decision === 'rejected' ? prompt('拒绝理由（必填）：') : '用户接受全部建议';
  if (!reason) return;
  try {
    const res = await fetch('/api/advisory/' + taskId + '/decision', {
      method: 'POST', headers: { 'Content-Type': 'application/json', 'x-csrf-token': '<%= csrfToken %>' },
      body: JSON.stringify({ decision, reason }),
    });
    if (res.ok) { document.getElementById('task-detail').style.display = 'none'; loadPending(); }
    else { const d = await res.json(); alert('失败: ' + d.message); }
  } catch (err) { alert('网络错误'); }
}

// Load recent records for the ID field
async function loadRecentRecords() {
  try {
    const res = await fetch('/api/dashboard');
    const data = await res.json();
    const container = document.getElementById('recent-records');
    let html = '<table class="guide-table" style="margin-top:0"><thead><tr><th>类型</th><th>标题/内容</th><th>复制 UUID</th></tr></thead><tbody>';

    if (data.activeProjects?.length) {
      data.activeProjects.forEach(p => {
        html += '<tr><td><span class="status ready">项目</span></td><td>' + p.title + '</td><td><code style="cursor:pointer;font-size:11px" onclick="copyId(\'' + p.id + '\')">' + p.id.slice(0,12) + '…</code></td></tr>';
      });
    }
    if (data.latestCheckin) {
      const c = data.latestCheckin;
      html += '<tr><td><span class="status caution">决策</span></td><td>' + (c.main_action || '(空)').slice(0, 50) + '</td><td><code style="cursor:pointer;font-size:11px" onclick="copyId(\'' + c.id + '\')">' + c.id.slice(0,12) + '…</code></td></tr>';
    }
    if (!data.activeProjects?.length && !data.latestCheckin) {
      container.innerHTML = '<div class="warning-box"><strong>暂无记录</strong> — 先去<a href="/checkins/new" style="color:var(--green)">今日决策</a>或<a href="/projects" style="color:var(--green)">项目</a>创建一些记录，再回来使用顾问。</div>';
      return;
    }
    html += '</tbody></table>';
    container.innerHTML = html;
  } catch (err) {
    document.getElementById('recent-records').innerHTML = '<p class="empty">无法加载记录</p>';
  }
}

window.copyId = function(id) {
  navigator.clipboard.writeText(id).then(() => {
    const input = form.recordIds;
    input.value = input.value ? input.value + ', ' + id : id;
    input.focus();
  });
};

loadPending();
loadRecentRecords();
</script>

<%- include('partials/foot') %>
