<%- include('partials/head', { title }) %>
<section class="page-heading compact">
  <div><p class="eyebrow"><%= record.checkinDate %> · <%= record.rulesetVersion %> · <%= lifecycleLabel(record.lifecycleStatus) %></p><h1><%= record.mainAction %></h1><p><%= record.deliverable %></p><% if (record.projectTitle) { %><p>关联项目：<strong><%= record.projectTitle %></strong></p><% } %></div>
  <span class="status <%= record.analysis.status.toLowerCase() %>"><%= record.analysis.status %></span>
</section>

<% if (record.allowedLifecycleStatuses.length > 0) { %>
<section class="panel top-gap">
  <div class="panel-heading"><div><p class="eyebrow">执行状态</p><h2><%= lifecycleLabel(record.lifecycleStatus) %></h2></div></div>
  <div class="action-row">
    <% record.allowedLifecycleStatuses.forEach((status) => { %>
      <form method="post" action="/checkins/<%= record.id %>/lifecycle" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="<%= status %>"><button class="button <%= status === 'cancelled' ? 'secondary' : 'primary' %> small" type="submit"><%= lifecycleLabel(status) %></button></form>
    <% }) %>
  </div>
</section>
<% } %>

<section class="score-grid">
  <article><span>收益</span><strong><%= record.analysis.benefitBand %></strong><small>主要矛盾 + 瓶颈</small></article>
  <article><span>可行性</span><strong><%= record.analysis.feasibilityBand %></strong><small>资源、状态、证据取短板</small></article>
  <article><span>风险</span><strong><%= record.analysis.riskBand %></strong><small>硬门槛优先</small></article>
  <article><span>可用时间</span><strong><%= record.analysis.usableMinutes %>m</strong><small>已扣安全储备</small></article>
</section>

<section class="split-grid">
  <article class="panel accent-panel"><p class="eyebrow">推荐行动</p><h2><%= record.analysis.recommendation %></h2>
    <% if (record.analysis.reasons.length) { %><ul><% record.analysis.reasons.forEach((item) => { %><li><%= item %></li><% }) %></ul><% } %>
    <% if (record.analysis.warnings.length) { %><div class="warning-box"><strong>需要注意</strong><ul><% record.analysis.warnings.forEach((item) => { %><li><%= item %></li><% }) %></ul></div><% } %>
  </article>
  <article class="panel"><p class="eyebrow">行动边界</p><dl class="detail-list"><div><dt>阶段目标</dt><dd><%= record.stageGoal %></dd></div><div><dt>主要矛盾</dt><dd><%= record.mainContradiction %></dd></div><div><dt>当前瓶颈</dt><dd><%= record.bottleneck %></dd></div><div><dt>停止条件</dt><dd><%= record.stopCondition %></dd></div><div><dt>明确不做</dt><dd><%= record.explicitNotDo || '未填写' %></dd></div></dl></article>
</section>

<section class="panel top-gap">
  <div class="panel-heading"><div><p class="eyebrow">实践检验</p><h2>结果复盘</h2></div></div>
  <% if (outcome) { %>
    <div class="outcome-banner"><strong>闭环完成</strong><p><%= outcome.actual_result %></p></div>
    <div class="score-grid compact-scores"><article><span>决策过程</span><strong><%= outcome.decision_quality %>/10</strong></article><article><span>执行质量</span><strong><%= outcome.execution_quality %>/10</strong></article><article><span>环境影响</span><strong><%= outcome.environment_impact %></strong></article></div>
    <dl class="detail-list"><div><dt>偏差来源</dt><dd><%= outcome.variance_source %></dd></div><div><dt>得到的认识</dt><dd><%= outcome.learning %></dd></div><div><dt>下一步修正</dt><dd><%= outcome.next_adjustment %></dd></div></dl>
    <details class="outcome-correction"><summary>修正结果事实</summary><%- include('partials/outcome-form', { record, outcome, submitLabel: '保存修正' }) %></details>
  <% } else if (record.lifecycleStatus === 'awaiting_review') { %>
    <%- include('partials/outcome-form', { record, outcome: null, submitLabel: '完成闭环' }) %>
  <% } else if (record.lifecycleStatus === 'cancelled') { %>
    <div class="empty"><p>该决策已经取消，不再记录执行结果。需要继续时请建立一条新的正式决策。</p></div>
  <% } else { %>
    <div class="empty"><p>请先推进执行状态；到达“待复盘”后才会开放结果记录，避免把计划误当成已经执行。</p></div>
  <% } %>
</section>
<%- include('partials/foot') %>
