<Window
    x:Class="PraxisControl.Windows.CheckinWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="记录今日决策 · Praxis Control">
  <Grid Background="{StaticResource PraxisBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Padding="30,24,30,18" ColumnSpacing="16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Spacing="4">
        <TextBlock Text="今日决策" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource PraxisInkBrush}" />
        <TextBlock Text="先分析，再由你确认是否写入事实库。" Foreground="{StaticResource PraxisMutedBrush}" />
      </StackPanel>
      <TextBlock Grid.Column="1" Text="硬门槛优先于评分" VerticalAlignment="Center" Foreground="{StaticResource PraxisAccentBrush}" />
    </Grid>

    <ScrollViewer Grid.Row="1">
      <StackPanel Padding="30,0,30,28" Spacing="18" MaxWidth="980" HorizontalAlignment="Center">
        <Border Background="{StaticResource PraxisCardBrush}" BorderBrush="{StaticResource PraxisStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
          <StackPanel Spacing="14">
            <TextBlock Text="资源与状态" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Grid ColumnSpacing="12" RowSpacing="12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <CalendarDatePicker x:Name="CheckinDate" Header="日期" />
              <NumberBox x:Name="AvailableMinutes" Grid.Column="1" Header="可用分钟" Value="120" Minimum="0" Maximum="1440" SpinButtonPlacementMode="Compact" />
              <NumberBox x:Name="Energy" Grid.Column="2" Header="精力 0–10" Value="7" Minimum="0" Maximum="10" SpinButtonPlacementMode="Compact" />
              <NumberBox x:Name="Attention" Grid.Column="3" Header="注意力 0–10" Value="7" Minimum="0" Maximum="10" SpinButtonPlacementMode="Compact" />
            </Grid>
            <NumberBox x:Name="ReservePercent" Header="储备比例 %" Value="20" Minimum="0" Maximum="80" SpinButtonPlacementMode="Compact" />
          </StackPanel>
        </Border>

        <Border Background="{StaticResource PraxisCardBrush}" BorderBrush="{StaticResource PraxisStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
          <StackPanel Spacing="12">
            <TextBlock Text="方向与瓶颈" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBox x:Name="StageGoal" Header="当前阶段目标" TextWrapping="Wrap" />
            <TextBox x:Name="MainContradiction" Header="主要矛盾" TextWrapping="Wrap" />
            <TextBox x:Name="Bottleneck" Header="当前瓶颈" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Background="{StaticResource PraxisCardBrush}" BorderBrush="{StaticResource PraxisStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
          <StackPanel Spacing="12">
            <TextBlock Text="行动设计" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBox x:Name="MainAction" Header="唯一主要行动" TextWrapping="Wrap" />
            <TextBox x:Name="Deliverable" Header="本次可验证交付物" TextWrapping="Wrap" />
            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
              <NumberBox x:Name="EstimatedMinutes" Header="预计分钟" Value="60" Minimum="1" Maximum="1440" SpinButtonPlacementMode="Compact" />
              <TextBox x:Name="StopCondition" Grid.Column="1" Header="停止/复盘触发条件" TextWrapping="Wrap" />
            </Grid>
            <TextBox x:Name="ExplicitNotDo" Header="明确不做（可空）" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Background="{StaticResource PraxisCardBrush}" BorderBrush="{StaticResource PraxisStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
          <StackPanel Spacing="14">
            <TextBlock Text="证据、贡献与风险" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <NumberBox x:Name="ContradictionContribution" Header="矛盾贡献" Value="7" Minimum="0" Maximum="10" SpinButtonPlacementMode="Compact" />
              <NumberBox x:Name="BottleneckContribution" Grid.Column="1" Header="瓶颈贡献" Value="7" Minimum="0" Maximum="10" SpinButtonPlacementMode="Compact" />
              <NumberBox x:Name="EvidenceStrength" Grid.Column="2" Header="证据强度" Value="6" Minimum="0" Maximum="10" SpinButtonPlacementMode="Compact" />
              <ComboBox x:Name="RiskLevel" Grid.Column="3" Header="风险等级" SelectedIndex="0">
                <ComboBoxItem Content="低" Tag="low" /><ComboBoxItem Content="中" Tag="medium" /><ComboBoxItem Content="高" Tag="high" />
              </ComboBox>
            </Grid>
            <Grid ColumnSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <StackPanel Spacing="8">
                <CheckBox x:Name="HasAuthorization" Content="已取得所需授权" />
                <CheckBox x:Name="LossTolerable" Content="最坏损失可承受" IsChecked="True" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="8">
                <CheckBox x:Name="HasRecoveryPlan" Content="已有恢复/回滚方案" />
                <CheckBox x:Name="OpensNewCoreProject" Content="该行动会新增核心项目" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <InfoBar x:Name="ResultBar" IsOpen="False" IsClosable="False" Title="分析结果">
          <StackPanel Spacing="8">
            <TextBlock x:Name="Recommendation" TextWrapping="Wrap" FontWeight="SemiBold" />
            <TextBlock x:Name="AnalysisDetails" TextWrapping="Wrap" />
          </StackPanel>
        </InfoBar>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="{StaticResource PraxisSurfaceBrush}" Padding="24,14">
      <Grid MaxWidth="980" HorizontalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock x:Name="FooterStatus" Text="尚未分析" VerticalAlignment="Center" Foreground="{StaticResource PraxisMutedBrush}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
          <Button Content="先分析" Click="Analyze_Click" />
          <Button x:Name="SaveButton" Content="确认并保存" Click="Save_Click" IsEnabled="False" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
