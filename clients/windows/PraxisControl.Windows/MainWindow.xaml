<Window
    x:Class="PraxisControl.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Praxis Control">
  <ScrollViewer Background="{StaticResource PraxisBackgroundBrush}">
    <Grid MaxWidth="1040" Padding="36" HorizontalAlignment="Center">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" ColumnSpacing="18">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Spacing="5">
          <TextBlock Text="PRAXIS CONTROL" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PraxisAccentBrush}" CharacterSpacing="120" />
          <TextBlock Text="实践控制台" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource PraxisInkBrush}" />
          <TextBlock Text="克制地判断，留下可复核的证据。" FontSize="14" Foreground="{StaticResource PraxisMutedBrush}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="记录今日决策" Click="NewCheckin_Click" IsEnabled="{x:Bind IsConnected, Mode=OneWay}" />
          <Button Content="打开 Web" Click="OpenWeb_Click" IsEnabled="{x:Bind IsConnected, Mode=OneWay}" />
          <Button Content="刷新" Click="Refresh_Click" />
          <Button Content="安全关闭服务" Click="Shutdown_Click" IsEnabled="{x:Bind IsConnected, Mode=OneWay}" />
        </StackPanel>
      </Grid>

      <Border Grid.Row="1" Margin="0,26,0,18" Padding="16,12" Background="{StaticResource PraxisSurfaceBrush}" CornerRadius="8">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Ellipse Width="10" Height="10" Fill="{StaticResource PraxisAccentBrush}" VerticalAlignment="Center" />
          <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Foreground="{StaticResource PraxisInkBrush}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Grid Grid.Row="2" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Padding="18" Background="{StaticResource PraxisCardBrush}" BorderBrush="{StaticResource PraxisStrokeBrush}" BorderThickness="1" CornerRadius="8">
          <StackPanel Spacing="8"><TextBlock Text="核心 WIP" Foreground="{StaticResource PraxisMutedBrush}" /><TextBlock Text="{x:Bind ActiveWip, Mode=OneWay}" FontSize="30" FontWeight="SemiBold" /></StackPanel>
        </Border>
        <Border Grid.Column="1" Padding="18" Background="{StaticResource PraxisCardBrush}" BorderBrush="{StaticResource PraxisStrokeBrush}" BorderThickness="1" CornerRadius="8">
          <StackPanel Spacing="8"><TextBlock Text="待结果复盘" Foreground="{StaticResource PraxisMutedBrush}" /><TextBlock Text="{x:Bind AwaitingReview, Mode=OneWay}" FontSize="30" FontWeight="SemiBold" /></StackPanel>
        </Border>
        <Border Grid.Column="2" Padding="18" Background="{StaticResource PraxisCardBrush}" BorderBrush="{StaticResource PraxisStrokeBrush}" BorderThickness="1" CornerRadius="8">
          <StackPanel Spacing="8"><TextBlock Text="近 7 日闭环" Foreground="{StaticResource PraxisMutedBrush}" /><TextBlock Text="{x:Bind ReviewedLast7Days, Mode=OneWay}" FontSize="30" FontWeight="SemiBold" /></StackPanel>
        </Border>
        <Border Grid.Column="3" Padding="18" Background="{StaticResource PraxisCardBrush}" BorderBrush="{StaticResource PraxisStrokeBrush}" BorderThickness="1" CornerRadius="8">
          <StackPanel Spacing="8"><TextBlock Text="图谱" Foreground="{StaticResource PraxisMutedBrush}" /><TextBlock Text="{x:Bind GraphSummary, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" /></StackPanel>
        </Border>
      </Grid>

      <Grid Grid.Row="3" Margin="0,20,0,0" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="3*" />
          <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Padding="22" Background="{StaticResource PraxisCardBrush}" BorderBrush="{StaticResource PraxisStrokeBrush}" BorderThickness="1" CornerRadius="8">
          <StackPanel Spacing="10">
            <TextBlock Text="最近行动" FontSize="12" Foreground="{StaticResource PraxisMutedBrush}" />
            <TextBlock Text="{x:Bind LatestAction, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Padding="22" Background="{StaticResource PraxisSurfaceBrush}" CornerRadius="8">
          <StackPanel Spacing="10">
            <TextBlock Text="本轮边界" FontSize="12" Foreground="{StaticResource PraxisMutedBrush}" />
            <TextBlock Text="原生壳只经版本化 API 读取状态，不直接接触数据库。完整录入和关系探索可随时回退到 Web。" TextWrapping="Wrap" Foreground="{StaticResource PraxisInkBrush}" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </ScrollViewer>
</Window>
