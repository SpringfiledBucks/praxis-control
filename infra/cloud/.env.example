PRAXIS_APP_IMAGE=praxis-control-cloud:0.2.0-beta.1
PRAXIS_POSTGRES_IMAGE=postgres:16-bookworm
PRAXIS_BIND_PORT=4310
RULESET_VERSION=2026.07.28-mvp1
AI_MODE=disabled

# Local evaluation may use the mutable tags above. Production promotion must
# replace both values with repository@sha256 references and pass:
# sh release-preflight.sh

# Secret files default to infra/cloud/secrets. Absolute paths may be used instead.
# PRAXIS_DB_ADMIN_PASSWORD_FILE=/secure/path/database-admin-password.txt
# PRAXIS_DB_PASSWORD_FILE=/secure/path/database-app-password.txt
# PRAXIS_ACCESS_PASSWORD_FILE=/secure/path/access-password.txt
# PRAXIS_SESSION_SECRET_FILE=/secure/path/session-secret.txt
