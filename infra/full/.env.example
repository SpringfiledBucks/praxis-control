ACCESS_MODE=password
PRAXIS_BIND_PORT=4310

# 如密码文件不在 infra/full/secrets，可覆盖为绝对路径：
# PRAXIS_DB_ADMIN_PASSWORD_FILE=/secure/path/database-admin-password.txt
# PRAXIS_DB_PASSWORD_FILE=/secure/path/database-app-password.txt
# PRAXIS_ACCESS_PASSWORD_FILE=/secure/path/access-password.txt
# PRAXIS_SESSION_SECRET_FILE=/secure/path/session-secret.txt

# 仅在受可信身份头代理保护时改用：
# ACCESS_MODE=tailscale
# TAILSCALE_ALLOWED_USER=owner@example.com
